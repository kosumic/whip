{
  "name": "whip",
  "version": "1.9.1",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "main": "index.js",
  "scripts": {
    "android": "node scripts/sync-terminal-assets.ts && expo run:android",
    "bundle:ios": "expo export:embed --platform ios --dev false --entry-file index.js --bundle-output build/ios/main.jsbundle --assets-dest build/ios",
    "benchmark:terminal-bridge": "node --expose-gc scripts/benchmark-terminal-bridge.ts",
    "check:terminal-callback-cleanup": "node scripts/check-terminal-callback-cleanup.ts",
    "benchmark:chat-rows": "node --expose-gc scripts/benchmark-chat-rows.ts",
    "benchmark:codex-ingestion": "node scripts/benchmark-codex-ingestion.ts",
    "check:cargo-license-notices": "node scripts/check-cargo-license-notices.ts",
    "check:app-version": "node scripts/check-app-version.cjs",
    "check:scripts": "tsc --project scripts/tsconfig.json",
    "check:license-notices": "npm run check:npm-license-notices && npm run check:cargo-license-notices && node scripts/sync-bundled-license-notices.ts",
    "check:npm-license-notices": "node scripts/check-license-notices.ts",
    "generate:android-icon": "node scripts/generate-android-launcher-vector.ts",
    "generate:install-qr": "node scripts/generate-install-qr.ts",
    "generate:license-notices": "npm run check:npm-license-notices && npm run check:cargo-license-notices && node scripts/sync-bundled-license-notices.ts --write",
    "generate:readme-phone-mockups": "node scripts/generate-readme-phone-mockups.ts",
    "generate:readme-diagrams": "node scripts/render-readme-diagrams.ts",
    "start": "node scripts/sync-terminal-assets.ts && expo start --dev-client",
    "doctor": "expo-doctor",
    "lint": "eslint . --max-warnings 0 --report-unused-disable-directives",
    "worker:dev": "wrangler dev --config feedback-worker/wrangler.jsonc",
    "worker:types": "wrangler types feedback-worker/worker-configuration.d.ts --config feedback-worker/wrangler.jsonc --include-runtime false",
    "worker:check": "wrangler types feedback-worker/worker-configuration.d.ts --config feedback-worker/wrangler.jsonc --include-runtime false --check && wrangler deploy --dry-run --config feedback-worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config feedback-worker/wrangler.jsonc",
    "test": "jest",
    "postinstall": "patch-package && node scripts/sync-terminal-assets.ts && bash scripts/build-ios-uniffi.sh",
    "generate:ios-uniffi": "WHIP_BUILD_IOS_UNIFFI=1 bash scripts/build-ios-uniffi.sh",
    "eas-build-pre-install": "bash scripts/prepare-eas-ios.sh"
  },
  "dependencies": {
    "@callstack/liquid-glass": "0.8.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-clipboard/clipboard": "1.16.3",
    "@react-native-community/slider": "5.2.1",
    "@rn-primitives/portal": "^1.5.3",
    "@rn-primitives/separator": "^1.5.2",
    "@rn-primitives/slot": "^1.5.2",
    "@rn-primitives/switch": "^1.5.2",
    "@shopify/flash-list": "2.3.2",
    "@ubjs/core": "0.31.0-3",
    "@verevoir/qr": "2.1.0",
    "@xterm/addon-fit": "0.12.0-beta.311",
    "@xterm/addon-image": "0.10.0-beta.310",
    "@xterm/addon-serialize": "0.15.0-beta.310",
    "@xterm/xterm": "6.1.0-beta.315",
    "babel-preset-expo": "~58.0.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "3.4.17",
    "expo": "~58.0.19",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-battery": "~58.0.3",
    "expo-blur": "~58.0.5",
    "expo-camera": "~58.0.12",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.3",
    "expo-local-authentication": "~58.0.2",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.6",
    "expo-sensors": "~58.0.4",
    "expo-speech-recognition": "^58.0.0",
    "expo-status-bar": "~58.0.4",
    "expo-video": "~58.0.12",
    "expo-web-browser": "~58.0.6",
    "expo-whip-terminal-input": "file:packages/expo-whip-terminal-input",
    "i18next": "^26.5.6",
    "lucide-react-native": "^1.59.0",
    "marked": "18.1.1",
    "nativewind": "4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.3",
    "react-native": "0.88.0",
    "react-native-enriched-markdown": "1.1.1",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-keychain": "^10.0.0",
    "react-native-permissions": "5.6.3",
    "react-native-purchases": "^10.15.0",
    "react-native-purchases-ui": "^10.15.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-webview": "14.0.1",
    "react-native-whip-ssh": "file:packages/react-native-whip-ssh",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "uniffi-bindgen-react-native": "0.31.0-3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/runtime": "^7.29.10",
    "@cloudflare/workers-types": "^5.20261022.1",
    "@expo/plist": "^0.10.1",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@react-native/typescript-config": "0.88.0",
    "@sneas/telephone": "1.2.0",
    "@types/jest": "30.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "expo-dev-client": "~58.0.15",
    "expo-doctor": "1.21.5",
    "expo-mcp": "~0.2.1",
    "jest": "~30.5.2",
    "jsdom": "^30.1.3",
    "license-report": "6.8.6",
    "patch-package": "^8.0.1",
    "prettier": "3.9.10",
    "react-test-renderer": "19.3.0",
    "sharp": "0.35.5",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "enriched-markdown": {
    "enableCodeHighlight": true,
    "enableMath": true,
    "codeHighlightLanguages": [
      "rust",
      "typescript",
      "javascript",
      "tsx",
      "python",
      "bash",
      "json",
      "yaml",
      "markdown",
      "c",
      "cpp",
      "go"
    ]
  },
  "overrides": {
    "@hono/node-server": "2.0.10",
    "lodash-es": "4.18.1",
    "postcss-selector-parser": "7.1.7",
    "sharp": "$sharp",
    "uuid": "11.1.1"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-blur"
        ]
      }
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
