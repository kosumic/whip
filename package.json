{
  "name": "whip",
  "version": "1.0.2",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "main": "index.js",
  "scripts": {
    "android": "node scripts/sync-terminal-assets.mjs && expo run:android",
    "bundle:ios": "expo export:embed --platform ios --dev false --entry-file index.js --bundle-output build/ios/main.jsbundle --assets-dest build/ios",
    "benchmark:terminal-bridge": "node --experimental-default-type=module --expose-gc scripts/benchmark-terminal-bridge.mjs",
    "check:cargo-license-notices": "node scripts/check-cargo-license-notices.mjs",
    "check:license-notices": "npm run check:npm-license-notices && npm run check:cargo-license-notices && node scripts/sync-bundled-license-notices.mjs",
    "check:npm-license-notices": "node scripts/check-license-notices.mjs",
    "generate:android-icon": "node scripts/generate-android-launcher-vector.mjs",
    "generate:license-notices": "npm run check:npm-license-notices && npm run check:cargo-license-notices && node scripts/sync-bundled-license-notices.mjs --write",
    "generate:readme-phone-mockups": "node scripts/generate-readme-phone-mockups.mjs",
    "generate:readme-diagrams": "node scripts/render-readme-diagrams.mjs",
    "start": "node scripts/sync-terminal-assets.mjs && expo start --dev-client",
    "doctor": "expo-doctor",
    "lint": "eslint . --max-warnings 0 --report-unused-disable-directives",
    "worker:dev": "wrangler dev --config feedback-worker/wrangler.jsonc",
    "worker:types": "wrangler types feedback-worker/worker-configuration.d.ts --config feedback-worker/wrangler.jsonc --include-runtime false",
    "worker:check": "wrangler types feedback-worker/worker-configuration.d.ts --config feedback-worker/wrangler.jsonc --include-runtime false --check && wrangler deploy --dry-run --config feedback-worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config feedback-worker/wrangler.jsonc",
    "test": "jest",
    "postinstall": "patch-package && node scripts/sync-terminal-assets.mjs && bash scripts/build-ios-uniffi.sh",
    "generate:ios-uniffi": "WHIP_BUILD_IOS_UNIFFI=1 bash scripts/build-ios-uniffi.sh",
    "eas-build-pre-install": "bash scripts/prepare-eas-ios.sh"
  },
  "dependencies": {
    "@callstack/liquid-glass": "0.8.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@rn-primitives/portal": "^1.5.2",
    "@rn-primitives/separator": "^1.5.2",
    "@rn-primitives/slot": "^1.5.2",
    "@rn-primitives/switch": "^1.5.2",
    "@shopify/flash-list": "2.0.2",
    "@ubjs/core": "0.31.0-3",
    "@xterm/addon-fit": "0.12.0-beta.299",
    "@xterm/addon-image": "0.10.0-beta.299",
    "@xterm/addon-serialize": "0.15.0-beta.299",
    "@xterm/xterm": "6.1.0-beta.302",
    "babel-preset-expo": "~57.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~57.0.20",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.16",
    "expo-audio": "~57.0.3",
    "expo-blur": "~57.0.2",
    "expo-camera": "~57.0.4",
    "expo-crypto": "~57.0.2",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image-picker": "~57.0.16",
    "expo-keep-awake": "~57.0.1",
    "expo-local-authentication": "~57.0.2",
    "expo-localization": "~57.0.1",
    "expo-notifications": "~57.0.17",
    "expo-speech": "~57.0.2",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "i18next": "^26.4.0",
    "lucide-react-native": "^1.24.0",
    "mermaid": "11.17.2",
    "nativewind": "4.2.2",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^17.0.10",
    "react-native": "0.86.3",
    "react-native-code-highlighter": "^1.3.0",
    "react-native-enriched-markdown": "1.0.2",
    "react-native-keychain": "^10.0.0",
    "react-native-purchases": "^10.8.1",
    "react-native-purchases-ui": "^10.8.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-whip-ssh": "file:packages/react-native-whip-ssh",
    "react-native-worklets": "0.10.1",
    "react-syntax-highlighter": "^16.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "uniffi-bindgen-react-native": "0.31.0-3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@cloudflare/workers-types": "^5.20260825.1",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.86.3",
    "@react-native/jest-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@react-native/typescript-config": "0.87.1",
    "@sneas/telephone": "1.1.2",
    "@types/jest": "^29.5.13",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "expo-dev-client": "~57.0.18",
    "expo-doctor": "1.20.4",
    "expo-mcp": "~0.2.1",
    "jest": "^29.6.3",
    "license-report": "6.8.5",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "wrangler": "^4.125.0"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "enriched-markdown": {
    "enableCodeHighlight": true,
    "enableMath": true,
    "codeHighlightLanguages": [
      "rust",
      "typescript",
      "javascript",
      "tsx",
      "python",
      "bash",
      "json",
      "yaml",
      "markdown",
      "c",
      "cpp",
      "go"
    ]
  },
  "overrides": {
    "@hono/node-server": "2.0.10",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "3.15.1"
    },
    "fast-xml-parser": "5.7.0",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "prismjs": "1.30.0",
    "react-syntax-highlighter": "$react-syntax-highlighter",
    "uuid": "11.1.1"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
