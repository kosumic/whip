+    NSAttributedString *next = ENRMSearchHighlight(baseline, query);
+    objc_setAssociatedObject(view, &kENRMSearchBaselineKey, baseline, OBJC_ASSOCIATION_COPY_NONATOMIC);
+    objc_setAssociatedObject(view, &kENRMSearchPaintedKey, next, OBJC_ASSOCIATION_COPY_NONATOMIC);
+    objc_setAssociatedObject(view, &kENRMSearchQueryKey, query, OBJC_ASSOCIATION_COPY_NONATOMIC);
