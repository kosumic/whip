@@ -0,0 +1,42 @@
+#pragma once
+#import "ENRMUIKit.h"
+#import <React/RCTConvert.h>
+#import <React/RCTFont.h>
+
+static NSString *const ENRMSpeechCurrentAttribute = @"WhipSpeechCurrent";
+
+static inline NSRange ENRMSpeechMarkerRange(NSAttributedString *source)
+{
+  __block NSRange marker = NSMakeRange(NSNotFound, 0);
+  [source enumerateAttribute:ENRMSpeechCurrentAttribute inRange:NSMakeRange(0, source.length) options:0
+                 usingBlock:^(id value, NSRange range, BOOL *stop) {
+                   if (value) { marker = range; *stop = YES; }
+                 }];
+  return marker;
+}
+
+static inline NSAttributedString *ENRMSpeechPaint(NSAttributedString *source, NSDictionary *config,
+                                                 NSString *role, NSRange current)
+{
+  if (!config || source.length == 0) return source;
+  RCTUIColor *heard = [RCTConvert UIColor:config[@"heard"]];
+  RCTUIColor *upcoming = [RCTConvert UIColor:config[@"upcoming"]];
+  if (!heard || !upcoming) return source;
+  NSMutableAttributedString *text = [source mutableCopy];
+  NSRange all = NSMakeRange(0, source.length);
+  if ([role isEqualToString:@"heard"]) [text addAttribute:NSForegroundColorAttributeName value:heard range:all];
+  else if ([role isEqualToString:@"upcoming"]) [text addAttribute:NSForegroundColorAttributeName value:upcoming range:all];
+  else if (current.location != NSNotFound && NSMaxRange(current) <= source.length) {
+    [text addAttribute:NSForegroundColorAttributeName value:heard range:NSMakeRange(0, NSMaxRange(current))];
+    [text addAttribute:NSForegroundColorAttributeName value:upcoming
+                 range:NSMakeRange(NSMaxRange(current), source.length - NSMaxRange(current))];
+    [source enumerateAttribute:NSFontAttributeName inRange:current options:0
+                    usingBlock:^(UIFont *font, NSRange range, BOOL *stop) {
+                      if (!font || (font.fontDescriptor.symbolicTraits & UIFontDescriptorTraitBold)) return;
+                      UIFont *bold = [RCTFont updateFont:font withFamily:nil size:nil weight:config[@"weight"]
+                                                   style:nil variant:nil scaleMultiplier:1];
+                      if (bold) [text addAttribute:NSFontAttributeName value:bold range:range];
+                    }];
+  }
+  return text;
+}
