+package com.swmansion.enriched.markdown.spans
+
+import android.content.res.AssetManager
+import android.graphics.Typeface
+import android.text.Spannable
+import android.text.TextPaint
+import android.text.style.MetricAffectingSpan
+import com.facebook.react.common.assets.ReactFontManager
+
+/** Whip's optional, Expo-loaded UKai face. Apply after other font spans, before layout. */
+object ChatCjkFont {
+  private const val FONT_FAMILY = "WhipChatCJK"
+  private const val COVERAGE_ASSET = "chat-cjk-codepoints.bin"
+  private var coverage: ByteArray? = null
+
+  @Synchronized
+  private fun coverage(assets: AssetManager): ByteArray =
+    coverage ?: assets.open(COVERAGE_ASSET).use { it.readBytes() }.also { coverage = it }
+
+  fun apply(text: Spannable, assets: AssetManager) {
+    text.getSpans(0, text.length, CjkSpan::class.java).forEach { text.removeSpan(it) }
+    val supported = coverage(assets)
+    fun hasGlyph(codepoint: Int): Boolean =
+      codepoint / 8 < supported.size && (supported[codepoint / 8].toInt() and (1 shl (codepoint % 8))) != 0
+
+    var start = -1
+    var offset = 0
+    var typeface: Typeface? = null
+    fun flush(end: Int) {
+      if (start < 0) return
+      val font = typeface ?: ReactFontManager.getInstance().getTypeface(FONT_FAMILY, Typeface.NORMAL, assets).also { typeface = it }
+      text.setSpan(CjkSpan(font), start, end, Spannable.SPAN_EXCLUSIVE_EXCLUSIVE)
+      start = -1
+    }
+    while (offset < text.length) {
+      val codepoint = Character.codePointAt(text, offset)
+      // Keep variation selectors attached to their preceding ideograph.
+      val variationSelector = codepoint in 0xFE00..0xFE0F || codepoint in 0xE0100..0xE01EF
+      if (hasGlyph(codepoint) || (start >= 0 && variationSelector)) {
+        if (start < 0) start = offset
+      } else {
+        flush(offset)
+      }
+      offset += Character.charCount(codepoint)
+    }
+    flush(offset)
+  }
+
+  private class CjkSpan(private val font: Typeface) : MetricAffectingSpan() {
+    private fun apply(paint: TextPaint) {
+      val style = paint.typeface?.style ?: Typeface.NORMAL
+      paint.typeface = if (style == Typeface.NORMAL) font else Typeface.create(font, style)
+    }
+    override fun updateMeasureState(paint: TextPaint) = apply(paint)
+    override fun updateDrawState(paint: TextPaint) = apply(paint)
