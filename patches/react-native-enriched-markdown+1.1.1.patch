+static NSData *ENRMChatCjkCoverage(void)
+{
+  static NSData *coverage;
+  static dispatch_once_t onceToken;
+  dispatch_once(&onceToken, ^{
+    // The existing terminal resource bundle owns the shared font and coverage.
+    NSArray<NSBundle *> *containers = [NSBundle.allBundles arrayByAddingObjectsFromArray:NSBundle.allFrameworks];
+    for (NSBundle *container in containers) {
+      NSURL *url = [container URLForResource:@"WhipTerminalAssets" withExtension:@"bundle"];
+      NSBundle *bundle = url ? [NSBundle bundleWithURL:url] : nil;
+      NSURL *coverageURL = [bundle URLForResource:@"chat-cjk-codepoints" withExtension:@"bin"];
+      if (coverageURL) {
+        coverage = [NSData dataWithContentsOfURL:coverageURL];
+        break;
+      }
+    }
+  });
+  return coverage;
+}
+
+void ENRMApplyChatCjkFont(NSMutableAttributedString *string, NSRange range)
+{
+#if !TARGET_OS_OSX
+  static NSString *const fontFamily = @"WhipChatCJK";
+  NSString *fontName = [UIFont fontNamesForFamilyName:fontFamily].firstObject;
+  NSData *coverage = ENRMChatCjkCoverage();
+  if (!fontName || !coverage || range.length == 0) {
+    return;
+  }
+  const uint8_t *supported = coverage.bytes;
+  NSAttributedString *original = [string attributedSubstringFromRange:range];
+  [original enumerateAttribute:NSFontAttributeName
+                       inRange:NSMakeRange(0, original.length)
+                       options:0
+                    usingBlock:^(UIFont *font, NSRange fontRange, BOOL *stop) {
+    if (!font) return;
+    UIFont *cjkFont = [UIFont fontWithName:fontName size:font.pointSize];
+    UIFontDescriptorSymbolicTraits traits = font.fontDescriptor.symbolicTraits & (UIFontDescriptorTraitBold | UIFontDescriptorTraitItalic);
+    if (traits) {
+      UIFontDescriptor *descriptor = [cjkFont.fontDescriptor fontDescriptorWithSymbolicTraits:traits];
+      if (descriptor) cjkFont = [UIFont fontWithDescriptor:descriptor size:font.pointSize] ?: cjkFont;
+    }
+    // Composed sequences keep surrogate pairs and variation selectors intact.
+    [original.string enumerateSubstringsInRange:fontRange
+                                       options:NSStringEnumerationByComposedCharacterSequences
+                                    usingBlock:^(NSString *substring, NSRange substringRange, NSRange enclosingRange, BOOL *stop) {
+      unichar first = [substring characterAtIndex:0];
+      UTF32Char codepoint = first;
+      if (CFStringIsSurrogateHighCharacter(first) && substring.length > 1 &&
+          CFStringIsSurrogateLowCharacter([substring characterAtIndex:1])) {
+        codepoint = CFStringGetLongCharacterForSurrogatePair(first, [substring characterAtIndex:1]);
+      }
+      if (codepoint / 8 < coverage.length && (supported[codepoint / 8] & (1 << (codepoint % 8)))) {
+        [string addAttribute:NSFontAttributeName value:cjkFont
+                       range:NSMakeRange(range.location + substringRange.location, substringRange.length)];
+      }
+    }];
+  }];
+#endif
