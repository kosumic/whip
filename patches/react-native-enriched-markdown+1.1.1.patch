+NSOperation *ENRMHighlightedAttributedCodeAsync(NSAttributedString *plainCode, NSString *code,
+    NSString *_Nullable language, StyleConfig *config,
+    void (^completion)(NSAttributedString *_Nullable))
+{
+  static NSOperationQueue *queue;
