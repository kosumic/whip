+  NSBlockOperation *operation = [NSBlockOperation new];
+  __weak NSBlockOperation *weakOperation = operation;
+  [operation addExecutionBlock:^{
+    if (weakOperation.cancelled) return;
+    std::vector<Markdown::HighlightToken> tokens;
