+++ b/node_modules/react-native-enriched-markdown/cpp/parser/SpeechPresentation.hpp
@@ -0,0 +1,69 @@
+#pragma once
+#include "MD4CParser.hpp"
+#include <algorithm>
+#include <array>
+#include <utility>
+
+namespace Markdown {
+inline constexpr const char *SpeechCurrentAttribute = "whipSpeechCurrent";
+
+struct SpeechMark {
+  size_t start;
+  size_t end;
+  std::shared_ptr<MarkdownASTNode> node;
+};
+struct SpeechProjection {
+  std::string text;
+  std::vector<SpeechMark> marks;
+};
+inline void projectSpeech(const std::shared_ptr<MarkdownASTNode> &node, SpeechProjection &result) {
+  if (!node) return;
+  const auto start = result.text.size();
+  result.text += node->content;
+  for (const auto &child : node->children) projectSpeech(child, result);
+  if (node->type == NodeType::Highlight && result.text.size() > start)
+    result.marks.push_back({start, result.text.size(), node});
+}
+
+// Compare parsed text rather than counting == in source: literals in code,
+// existing highlights, links and Unicode must retain their original meaning.
+inline std::shared_ptr<MarkdownASTNode> prepareSpeech(
+    MD4CParser &parser, const std::string &original, std::shared_ptr<MarkdownASTNode> marked,
+    const Md4cFlags &flags, bool isGFM) {
+  using Key = std::array<bool, 10>;
+  const Key key{flags.underline, flags.latexMath, flags.superscript, flags.subscript,
+                flags.highlight, flags.permissiveAutolinks, flags.hardSoftBreaks,
+                flags.preserveBlankLines, flags.admonitions, isGFM};
+  struct Cache {
+    std::string source;
+    Key flags{};
+    std::shared_ptr<MarkdownASTNode> ast;
+    SpeechProjection projection;
+  };
+  static thread_local Cache cache;
+  constexpr size_t MaxCachedBytes = 128 * 1024;
+  Cache temporary;
+  auto &entry = original.size() <= MaxCachedBytes ? cache : temporary;
+  if (!entry.ast || entry.source != original || entry.flags != key) {
+    entry = {};
+    entry.source = original;
+    entry.flags = key;
+    entry.ast = parser.parse(original, flags, isGFM);
+    projectSpeech(entry.ast, entry.projection);
+  }
+  SpeechProjection next;
+  projectSpeech(marked, next);
+  if (next.text != entry.projection.text) return entry.ast;
+  std::shared_ptr<MarkdownASTNode> current;
+  for (const auto &mark : next.marks) {
+    const bool existed = std::any_of(entry.projection.marks.begin(), entry.projection.marks.end(),
+        [&](const SpeechMark &old) { return old.start == mark.start && old.end == mark.end; });
+    if (existed) continue;
+    if (current) return entry.ast;
+    current = mark.node;
+  }
+  if (!current) return entry.ast;
+  current->attributes[SpeechCurrentAttribute] = "true";
+  return marked;
+}
+} // namespace Markdown
