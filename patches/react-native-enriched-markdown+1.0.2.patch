+#pragma once
+#import "ENRMUIKit.h"
+
+// Return a decoration of the rendered string. The baseline remains intact for
+// copying, re-highlighting and restoring existing inline-code backgrounds.
+static inline NSAttributedString *ENRMSearchHighlight(NSAttributedString *source, NSString *query)
+{
+  if (query.length == 0 || source.length == 0) return source;
+  NSMutableAttributedString *text = [source mutableCopy];
+  NSUInteger offset = 0;
+  while (offset < source.length) {
+    NSRange range = [source.string rangeOfString:query options:NSCaseInsensitiveSearch
+                                         range:NSMakeRange(offset, source.length - offset)];
+    if (range.location == NSNotFound) break;
+    [text addAttribute:NSBackgroundColorAttributeName
+                 value:[RCTUIColor colorWithRed:1.0 green:0.75 blue:0.28 alpha:0.4] range:range];
+    offset = NSMaxRange(range);
+  }
+  return text;
+}
