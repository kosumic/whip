+import Foundation
+import CoreGraphics
+
+// A floating/undocked keyboard is an interior obstruction, not a bottom inset.
+// Use the real frame after conversion to the application's window coordinates.
+func keyboardFrameBottomOcclusion(frame: CGRect, in bounds: CGRect) -> CGFloat {
+  let overlap = bounds.intersection(frame)
+  guard !overlap.isNull, !overlap.isEmpty,
+        frame.maxY >= bounds.maxY - 1,
+        frame.minX <= bounds.minX + 1,
+        frame.maxX >= bounds.maxX - 1 else { return 0 }
+  return overlap.height
+}
