# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip
require File.join(File.dirname(Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "expo/package.json",
    {paths: [process.argv[1]]},
  )', __dir__]).strip), 'scripts/autolinking')

# Populate the resource glob before CocoaPods records files in its project,
# including installs where npm lifecycle scripts were skipped.
Pod::Executable.execute_command('node', [File.expand_path('../scripts/sync-terminal-assets.mjs', __dir__)])

platform :ios, '16.4'
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'HerdR' do
  use_expo_modules!
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # Generate on the resource bundle target itself, before Xcode copies files.
    # An app-target phase can race with this dependency's resource packaging.
    terminal_assets = installer.target_installation_results.pod_target_installation_results.fetch('WhipTerminalAssets')
    terminal_assets.resource_bundle_targets.each do |bundle_target|
      phase = bundle_target.new_shell_script_build_phase('Sync terminal assets')
      phase.shell_path = '/bin/bash'
      phase.shell_script = <<~'SH'
        set -euo pipefail
        source "$PODS_ROOT/../.xcode.env"
        if [[ -f "$PODS_ROOT/../.xcode.env.local" ]]; then
          source "$PODS_ROOT/../.xcode.env.local"
        fi
        "$NODE_BINARY" "$PODS_ROOT/../../scripts/sync-terminal-assets.mjs"
      SH
      phase.always_out_of_date = '1'
      # Generation above has populated both directories. Declare every copied
      # and rendered file, including fonts, licenses, and HTML, as an output.
      phase.output_paths = Dir.glob(File.expand_path(
        '../{android/app/src/main/assets,modules/whip-terminal-assets/ios/TerminalAssets}/*', __dir__
      )).sort
      bundle_target.build_phases.delete(phase)
      bundle_target.build_phases.insert(0, phase)
      bundle_target.build_configurations.each do |configuration|
        configuration.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
      end
    end

    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
