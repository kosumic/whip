{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "ios-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true,
        "image": "latest"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "image": "sdk-57",
        "buildType": "apk"
      }
    },
    "production": {
      "environment": "production",
      "ios": {
        "env": {
          "WHIP_DISTRIBUTION_CHANNEL": "app-store"
        }
      }
    }
  },
  "submit": {
    "internal-draft": {
      "android": {
        "serviceAccountKeyPath": ".eas-secrets/google-play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "internal": {
      "android": {
        "serviceAccountKeyPath": ".eas-secrets/google-play-service-account.json",
        "track": "internal",
        "releaseStatus": "completed"
      }
    },
    "closed": {
      "android": {
        "serviceAccountKeyPath": ".eas-secrets/google-play-service-account.json",
        "track": "alpha",
        "releaseStatus": "completed"
      }
    },
    "production-draft": {
      "android": {
        "serviceAccountKeyPath": ".eas-secrets/google-play-service-account.json",
        "track": "production",
        "releaseStatus": "draft",
        "changesNotSentForReview": true
      }
    },
    "production": {
      "extends": "production-draft",
      "android": {
        "releaseStatus": "completed",
        "changesNotSentForReview": false
      },
      "ios": {
        "ascAppId": "6808226150"
      }
    }
  }
}
