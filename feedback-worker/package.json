{
  "name": "whip-feedback-worker",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.3.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types worker-configuration.d.ts --include-runtime false",
    "types:check": "wrangler types worker-configuration.d.ts --include-runtime false --check",
    "typecheck": "tsc --project tsconfig.test.json",
    "lint": "eslint . --max-warnings 0 --report-unused-disable-directives",
    "test": "jest --runInBand",
    "build": "wrangler deploy --dry-run",
    "check": "npm run typecheck && npm run lint && npm test && npm run types:check && npm run build",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@babel/core": "^8.0.10",
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@cloudflare/workers-types": "^5.20261029.1",
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.68.0",
    "babel-jest": "~30.5.2",
    "eslint": "^8.57.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "jest": "~30.5.2",
    "typescript": "~6.0.3",
    "wrangler": "^4.155.0"
  }
}
